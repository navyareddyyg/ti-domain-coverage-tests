        { "value": "ghe.com", "occurrence": 1, "role": "alias-suffix-match", "explanation": "Tenancy category suffix." },
        { "value": "comment.microsoft.com", "occurrence": 1, "role": "documentation-example", "explanation": "Quoted prose containing fake assignment syntax." },
        { "value": "commented.microsoft.com", "occurrence": 1, "role": "documentation-example", "explanation": "Source comment." }
      ]
    },
    {
