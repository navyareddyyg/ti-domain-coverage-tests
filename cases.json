        { "value": "strings.HasSuffix", "occurrence": 1, "role": "filename-identifier", "explanation": "Function selector, not a hostname." },
        { "value": "npmjs.org", "occurrence": 2, "role": "alias-suffix-match", "explanation": "Suffix category, not an exact destination." },
        { "value": "github.com", "occurrence": 1, "role": "alias-suffix-match", "explanation": "Return context deliberately does not establish a destination." }
