      "expected": [
        { "value": "api.github.com", "occurrence": 1, "role": "destination", "explanation": "Configured exact destination hostname." },
        { "value": "api.nuget.org", "occurrence": 1, "role": "destination", "explanation": "Explicit egress destination." },
        { "value": "registry.npmjs.org", "occurrence": 1, "role": "destination", "explanation": "Explicit egress destination." }
      ]
