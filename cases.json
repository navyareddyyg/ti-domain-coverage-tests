        { "value": "api.github.com", "occurrence": 1, "role": "destination", "explanation": "Exact host equality, not a suffix comparison." },
        { "value": "configuration.ServerAddress", "occurrence": 1, "role": "filename-identifier", "explanation": "Source member expression assigned to Host." },
